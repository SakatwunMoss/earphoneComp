NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics (GA4) Measurement ID
NEXT_PUBLIC_GA_ID=

# サイトの正規ベース URL（未設定時は https://earphone-comp.vercel.app）
