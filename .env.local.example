# SUPABASE_URL=
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
# Web application 登録時のみ（許可ドメインと一致させる）
# RAKUTEN_ORIGIN=https://earphone-comp.vercel.app

# Yahoo!ショッピングアフィリエイトリンク同期 (scripts/sync-yahoo-links.mjs)
YAHOO_APP_ID=
# または YAHOO_CLIENT_ID=（YAHOO_APP_ID 未設定時に利用）
VC_SID=
VC_PID=
